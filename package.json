{
  "name": "freeflowchart-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Render FlowScript flowcharts to PNG/PDF from the command line or an MCP server, offline.",
  "type": "module",
  "bin": {
    "freeflowchart": "bin/cli.js",
    "freeflowchart-mcp": "bin/mcp.js"
  },
  "exports": {
    ".": "./lib/render.js",
    "./tokenize": "./lib/tokenize.js"
  },
  "scripts": {
    "sync-renderer": "scripts/sync-renderer.sh",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "puppeteer": "^23.11.1",
    "zod": "^3.25.76"
  }
}
