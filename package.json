{
  "name": "freeflowchart",
  "version": "0.1.1",
  "description": "Turn simple text (FlowScript) into flowchart PNG/PDF, offline. CLI and MCP server for AI agents.",
  "mcpName": "io.github.northwindapps/freeflowchart",
  "keywords": [
    "flowchart",
    "diagram",
    "mcp",
    "mcp-server",
    "ai-agent",
    "png",
    "pdf",
    "cli"
  ],
  "homepage": "https://freeflowchart.web.app",
  "author": "Yujin Yano",
  "license": "MIT",
  "type": "module",
  "bin": {
    "freeflowchart": "bin/cli.js",
    "freeflowchart-mcp": "bin/mcp.js"
  },
  "exports": {
    ".": "./lib/render.js",
    "./tokenize": "./lib/tokenize.js"
  },
  "files": [
    "bin/",
    "lib/",
    "renderer/",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-renderer": "scripts/sync-renderer.sh",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@puppeteer/browsers": "^3.2.6",
    "puppeteer-core": "^25.16.0",
    "zod": "^3.25.76"
  }
}
